<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>WacomInputTest</AssemblyName>
    <RootNamespace>WacomLocalBridge</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\vendor\wacom\WacomMTDN\*.cs" Link="vendor\WacomMTDN\%(Filename)%(Extension)" />
    <Compile Include="..\vendor\wacom\WintabDN\*.cs" Link="vendor\WintabDN\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\index.html" Link="Web\index.html" LogicalName="WacomLocalBridge.Web.index.html" />
    <EmbeddedResource Include="..\..\app.js" Link="Web\app.js" LogicalName="WacomLocalBridge.Web.app.js" />
    <EmbeddedResource Include="..\..\styles.css" Link="Web\styles.css" LogicalName="WacomLocalBridge.Web.styles.css" />
  </ItemGroup>
</Project>
